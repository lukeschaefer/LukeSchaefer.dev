		<div
			data-owl-stats
			class="font-comic grid max-h-0 w-full grid-cols-2 gap-3 overflow-hidden transition-all duration-700 ease-out max-sm:group-data-[stats-open]:mt-3 max-sm:group-data-[stats-open]:max-h-96 sm:flex sm:w-0 sm:max-h-none sm:flex-col sm:group-data-[stats-open]:ml-3 sm:group-data-[stats-open]:w-40"
		>
			<div
				class="order-1 flex flex-col items-center justify-center gap-1 rounded-lg border border-zinc-300 opacity-0 transition-opacity duration-500 bg-white px-2 py-3 text-center text-black shadow-sm dark:border-zinc-600 sm:order-1 sm:flex-1"
			>
				<span class="text-[12px]">Owls generated</span>
				<span data-owl-stat-value class="text-[18px]">?</span>
			</div>
			<div
				class="order-2 flex flex-col items-center justify-center gap-1 rounded-lg border border-zinc-300 opacity-0 transition-opacity duration-500 bg-white px-2 py-3 text-center text-black shadow-sm dark:border-zinc-600 sm:order-2 sm:flex-1"
			>
				<span class="text-[12px]">Owl budget consumed</span>
				<span data-owl-stat-value class="text-[18px]">?</span>
			</div>
			<div
				class="order-4 flex flex-col items-center justify-center gap-1 rounded-lg border border-zinc-300 opacity-0 transition-opacity duration-500 bg-white px-2 py-3 text-center text-black shadow-sm dark:border-zinc-600 sm:order-3 sm:flex-1"
			>
				<span class="text-[12px]">Owl budget remaining</span>
				<span data-owl-stat-value class="text-[18px]">?</span>
			</div>
			<a
				data-owl-contribute
				href="https://buymeacoffee.com/luke.zip"
				target="_blank"
				rel="noreferrer"
				class="order-3 flex cursor-pointer appearance-none flex-col items-center justify-center gap-1 rounded-lg border border-zinc-300 opacity-0 transition-opacity duration-500 bg-white px-2 py-3 text-center text-[14px] text-black no-underline shadow-sm outline-none hover:border-black dark:border-zinc-600 sm:order-4 sm:flex-1"
			>
				Contribute owl funds
			</a>
		</div>
	</div>

	<p
		data-owl-error
		role="alert"
		class="font-comic mt-3 hidden w-full items-center justify-center gap-2 text-center text-sm text-red-600"
	>
		<svg
			data-owl-error-icon
			class="hidden h-4 w-4 shrink-0"
			viewBox="0 0 24 24"
			fill="currentColor"
			aria-hidden="true"
		>
			<path d="M12 3 1 21h22L12 3zm1 14h-2v2h2v-2zm0-7h-2v5h2V10z"></path>
		</svg>
		<span data-owl-error-message></span>
		<a
			data-owl-error-cta
			href="https://buymeacoffee.com/luke.zip"
			target="_blank"
			rel="noreferrer"
			class="hidden font-bold text-red-700 underline decoration-red-700 underline-offset-2"
		>
			Contribute owl funds
		</a>
	</p>
</div>

<script>
	import {
		canGenerateOwl,
		DEFAULT_OWL_BUDGET_USD,
		owlBudgetConsumed,
		owlBudgetRemaining,
	} from "../../api/owlBudget";
	import { DEFAULT_OWL_CIRCLES } from "../../api/owlCircles";
	import { pencilfyOwl, type OwlCircle } from "@/utils/pencilfyOwl";

	type Circle = OwlCircle;

	const MAX_CIRCLES = 2;
	const SKETCH_BLUR_PX = 12;
	const UI_IDLE_FADE_OUT_MS = 5000;
	const UI_IDLE_RESET_MS = 300;
	const CIRCLE_BLUR_PX = 6;
	const UI_REVEAL_FADE_MS = 1000;
	const STEP2_DELAY_AFTER_AI_MS = 500;
	const RESTART_DELAY_AFTER_STEP2_MS = 1500;

	const STATS_EXPAND_MS = 700;
	const STATS_STAGGER_MS = 200;

	const STEP2_LABEL = "2. Draw the rest of the owl";
	const STEP2_CHEAT_LABEL = "2. Cheat with a procedurally generated owl...";
	const STEP3_CHEAT_LABEL = "3. Draw the rest of the owl";
	const CHEAT_PENCIL_FADE_MS = 1000;

	function createCirclePencilTexture() {
		const texture = document.createElement("canvas");
		texture.width = 96;
		texture.height = 96;
		const textureCtx = texture.getContext("2d")!;
		const image = textureCtx.createImageData(texture.width, texture.height);

		for (let i = 0; i < image.data.length; i += 4) {
			const grain = Math.random();
			const graphite = 28 + Math.floor(Math.random() * 30);

			image.data[i] = graphite;
			image.data[i + 1] = graphite + Math.floor(Math.random() * 6);
			image.data[i + 2] = graphite + 10 + Math.floor(Math.random() * 8);
			image.data[i + 3] = grain > 0.86 ? 0 : 105 + Math.floor(grain * 150);
		}

		textureCtx.putImageData(image, 0, 0);
		return texture;
	}

	function hideOverlay(el: HTMLImageElement) {
		el.style.transition = "none";
		el.style.opacity = "0";
		el.style.filter = "";
		el.style.pointerEvents = "none";
		el.removeAttribute("src");
		void el.offsetWidth;
		el.style.transition = "";
	}

	function fadeInElement(el: HTMLElement, durationMs: number) {
		el.style.transition = "none";
		el.style.opacity = "0";
		void el.offsetWidth;
		el.style.transition = `opacity ${durationMs}ms ease`;
		el.style.opacity = "1";
	}

	function fadeOutElement(el: HTMLElement, durationMs: number) {
		el.style.transition = `opacity ${durationMs}ms ease`;
		el.style.opacity = "0";
	}

	function fadeOverlay(
		el: HTMLImageElement,
		src: string,
		durationMs: number,
		options?: { blurFromPx?: number },
	) {
		const blurFromPx = options?.blurFromPx;
		el.style.transition = "none";
		el.style.opacity = "0";
		if (blurFromPx != null) {
			el.style.filter = `blur(${blurFromPx}px)`;
		}
		el.src = src;
		void el.offsetWidth;
		el.style.transition =
			blurFromPx != null
				? `opacity ${durationMs}ms ease, filter ${durationMs}ms ease`
				: `opacity ${durationMs}ms ease`;
		el.style.opacity = "1";
		el.style.pointerEvents = "auto";
		if (blurFromPx != null) {
			el.style.filter = "blur(0px)";
		}
	}

	function pixelLuminance(r: number, g: number, b: number) {
		return 0.299 * r + 0.587 * g + 0.114 * b;
	}

	const WHITE_POINT_HIGHLIGHT_FRACTION = 0.1;

	function luminanceHistogram(data: Uint8ClampedArray) {
		const hist = new Uint32Array(256);
		for (let i = 0; i < data.length; i += 4) {
			const y = Math.min(
				255,
				Math.round(pixelLuminance(data[i]!, data[i + 1]!, data[i + 2]!)),
			);
			hist[y]! += 1;
		}
		return hist;
	}

	/** Lowest luminance among the brightest `fraction` of pixels (e.g. 0.1 → 90th percentile). */
	function highlightWhitePoint(hist: Uint32Array, pixelCount: number, fraction: number) {
		let remaining = Math.max(1, Math.ceil(pixelCount * fraction));
		for (let y = 255; y >= 0; y--) {
			remaining -= hist[y]!;
			if (remaining <= 0) return y;
		}
		return 0;
	}

	async function normalizeAiImageWhitePoint(dataUrl: string): Promise<string> {
		const img = new Image();
		await new Promise<void>((resolve, reject) => {
			img.onload = () => resolve();
			img.onerror = () => reject(new Error("Failed to load AI image."));
			img.src = dataUrl;
		});

		const work = document.createElement("canvas");
		work.width = img.naturalWidth;
		work.height = img.naturalHeight;
		const workCtx = work.getContext("2d");
		if (!workCtx) return dataUrl;

		workCtx.drawImage(img, 0, 0);
		const imageData = workCtx.getImageData(0, 0, work.width, work.height);
		const { data } = imageData;
		const pixelCount = data.length / 4;

		const hist = luminanceHistogram(data);
		const whitePoint = highlightWhitePoint(
			hist,
			pixelCount,
			WHITE_POINT_HIGHLIGHT_FRACTION,
		);

		if (whitePoint >= 255 || whitePoint < 1) return dataUrl;

		// Average RGB at the threshold so cream paper becomes true white, not brighter cream.
		let sumR = 0;
		let sumG = 0;
		let sumB = 0;
		let n = 0;
		for (let i = 0; i < data.length; i += 4) {
			const y = Math.min(
				255,
				Math.round(pixelLuminance(data[i]!, data[i + 1]!, data[i + 2]!)),
			);
			if (y !== whitePoint) continue;
			sumR += data[i]!;
			sumG += data[i + 1]!;
			sumB += data[i + 2]!;
			n += 1;
		}

		const whiteR = n > 0 ? sumR / n : whitePoint;
		const whiteG = n > 0 ? sumG / n : whitePoint;
		const whiteB = n > 0 ? sumB / n : whitePoint;
		const scaleR = 255 / Math.max(whiteR, 1);
		const scaleG = 255 / Math.max(whiteG, 1);
		const scaleB = 255 / Math.max(whiteB, 1);

		const curveR = new Uint8Array(256);
		const curveG = new Uint8Array(256);
		const curveB = new Uint8Array(256);
		for (let v = 0; v < 256; v++) {
			curveR[v] = Math.min(255, Math.round(v * scaleR));
			curveG[v] = Math.min(255, Math.round(v * scaleG));
			curveB[v] = Math.min(255, Math.round(v * scaleB));
		}

		for (let i = 0; i < data.length; i += 4) {
			data[i] = curveR[data[i]!]!;
			data[i + 1] = curveG[data[i + 1]!]!;
			data[i + 2] = curveB[data[i + 2]!]!;
		}

		workCtx.putImageData(imageData, 0, 0);
		return work.toDataURL("image/png");
	}

	document.querySelectorAll<HTMLElement>("[data-owl]").forEach((root) => {
		const canvas = root.querySelector<HTMLCanvasElement>("[data-owl-canvas]");
		const ctx = canvas?.getContext("2d");
		if (!canvas || !ctx) return;
		const pencilTexture = createCirclePencilTexture();
		const pencilPattern = ctx.createPattern(pencilTexture, "repeat");

		const pencilOverlay = root.querySelector<HTMLImageElement>("[data-owl-pencil-overlay]")!;
		const aiOverlay = root.querySelector<HTMLImageElement>("[data-owl-ai-overlay]")!;
		const step1Label = root.querySelector<HTMLElement>("[data-owl-step1]")!;
		const step2Label = root.querySelector<HTMLElement>("[data-owl-step2]")!;
		const bottomIdle = root.querySelector<HTMLElement>("[data-owl-bottom-idle]")!;
		const clearBtns = Array.from(
			root.querySelectorAll<HTMLButtonElement>("[data-owl-clear]"),
		);
		const restartBtn = root.querySelector<HTMLButtonElement>("[data-owl-restart]")!;
		const compareBtn = root.querySelector<HTMLButtonElement>("[data-owl-compare]")!;
		const cheatCheckbox = root.querySelector<HTMLInputElement>("[data-owl-cheat]")!;
		const externalCheatCheckbox = document.querySelector<HTMLInputElement>(
			"[data-owl-cheat-control]",
		);
		const errorEl = root.querySelector<HTMLElement>("[data-owl-error]")!;
		const errorIcon = root.querySelector("[data-owl-error-icon]")!;
		const errorMessageEl = root.querySelector<HTMLElement>("[data-owl-error-message]")!;
		const errorCta = root.querySelector<HTMLElement>("[data-owl-error-cta]")!;
		const statsPanel = root.querySelector<HTMLElement>("[data-owl-stats]")!;
		const statBoxes = Array.from(statsPanel.children) as HTMLElement[];
		const statValues = statBoxes.slice(0, 3).map((box) =>
			box.querySelector<HTMLElement>("[data-owl-stat-value]"),
		);
		let statsRevealed = false;

		const circles: Circle[] = DEFAULT_OWL_CIRCLES.map((c) => ({ ...c }));
		let start: { x: number; y: number } | null = null;
		let preview: Circle | null = null;
		let loading = false;
		let revealed = false;
		let uiActive = false;
		let cheatProceduralDone = false;
		let generationId = 0;
		let uiTimeouts: ReturnType<typeof setTimeout>[] = [];
		let budgetDepleted = false;
		let budgetUsd = DEFAULT_OWL_BUDGET_USD;

		const pencilCanvas = document.createElement("canvas");
		pencilCanvas.width = canvas.width;
		pencilCanvas.height = canvas.height;

		function strokeEllipse(c: Circle) {
			ctx!.save();
			ctx!.globalCompositeOperation = "multiply";
			ctx!.globalAlpha = 0.78;
			ctx!.strokeStyle = pencilPattern ?? "#374151";
			ctx!.lineWidth = 14;
			ctx!.lineCap = "round";
			for (let pass = 0; pass < 2; pass++) {
				const jitter = pass === 0 ? 0 : 2;
				ctx!.beginPath();
				ctx!.ellipse(c.cx + jitter, c.cy - jitter, c.rx, c.ry, 0, 0, Math.PI * 2);
				ctx!.stroke();
			}
			ctx!.restore();
		}

		function render() {
			ctx!.fillStyle = "#ffffff";
			ctx!.fillRect(0, 0, canvas!.width, canvas!.height);
			for (const c of circles) strokeEllipse(c);
			if (preview) strokeEllipse(preview);
		}

		function clearUiTimeouts() {
			for (const timeout of uiTimeouts) clearTimeout(timeout);
			uiTimeouts = [];
		}

		function isCheatMode() {
			return cheatCheckbox.checked;
		}

		function setPencilBlendMode(useMultiply: boolean) {
			pencilOverlay.classList.toggle("mix-blend-multiply", useMultiply);
		}

		function updateIdleLabels() {
			if (isCheatMode()) {
				step2Label.textContent = STEP2_CHEAT_LABEL;
				compareBtn.textContent = cheatProceduralDone ? STEP3_CHEAT_LABEL : STEP2_CHEAT_LABEL;
			} else {
				step2Label.textContent = STEP2_LABEL;
				compareBtn.textContent = STEP2_LABEL;
			}
		}

		function buildCheatOverlayImage() {
			pencilfyOwl(pencilCanvas, circles, { background: null });
			return pencilCanvas.toDataURL("image/png");
		}

		function resetOverlays() {
			generationId += 1;
			revealed = false;
			cheatProceduralDone = false;
			clearUiTimeouts();
			setPencilBlendMode(true);
			hideOverlay(pencilOverlay);
			hideOverlay(aiOverlay);
		}

		function blurCircleLayer(durationMs: number) {
			canvas!.style.transition = "none";
			canvas!.style.filter = "blur(0px)";
			void canvas!.offsetWidth;
			canvas!.style.transition = `filter ${durationMs}ms ease`;
			canvas!.style.filter = `blur(${CIRCLE_BLUR_PX}px)`;
		}

		function resetCircleBlur() {
			canvas!.style.transition = "none";
			canvas!.style.filter = "";
			void canvas!.offsetWidth;
			canvas!.style.transition = "";
		}

		function beginDrawing() {
			uiActive = true;
			clearUiTimeouts();
			step2Label.style.opacity = "0";
			restartBtn.style.opacity = "0";
			restartBtn.style.pointerEvents = "none";
			fadeOutElement(step1Label, UI_IDLE_FADE_OUT_MS);
			fadeOutElement(bottomIdle, UI_IDLE_FADE_OUT_MS);
			bottomIdle.style.pointerEvents = "none";
			blurCircleLayer(UI_IDLE_FADE_OUT_MS);
		}

		function beginCheatDrawing() {
			uiActive = true;
			clearUiTimeouts();
			step1Label.style.transition = "none";
			step1Label.style.opacity = "0";
			step2Label.textContent = STEP2_CHEAT_LABEL;
			step2Label.style.transition = "none";
			step2Label.style.opacity = "1";
			void step1Label.offsetWidth;
			step1Label.style.transition = "";
			step2Label.style.transition = "";
			restartBtn.style.opacity = "0";
			restartBtn.style.pointerEvents = "none";
			fadeOutElement(bottomIdle, UI_IDLE_FADE_OUT_MS);
			bottomIdle.style.pointerEvents = "none";
		}

		function revealCompleteUi(activeId: number, options?: { skipStep2?: boolean }) {
			if (!options?.skipStep2) {
				uiTimeouts.push(
					setTimeout(() => {
						if (activeId !== generationId) return;
						fadeInElement(step2Label, UI_REVEAL_FADE_MS);
					}, STEP2_DELAY_AFTER_AI_MS),
				);
			}

			uiTimeouts.push(
				setTimeout(() => {
					if (activeId !== generationId) return;
					fadeInElement(restartBtn, UI_REVEAL_FADE_MS);
					restartBtn.style.pointerEvents = "auto";
				}, options?.skipStep2
					? RESTART_DELAY_AFTER_STEP2_MS
					: STEP2_DELAY_AFTER_AI_MS + RESTART_DELAY_AFTER_STEP2_MS),
			);
		}

		function showCheatStep2Ui() {
			cheatProceduralDone = true;
			uiActive = false;
			compareBtn.textContent = STEP3_CHEAT_LABEL;
			fadeInElement(bottomIdle, UI_REVEAL_FADE_MS);
			bottomIdle.style.pointerEvents = "auto";
			syncControls();
		}

		function resetUi() {
			uiActive = false;
			clearUiTimeouts();
			resetCircleBlur();
			step1Label.style.transition = `opacity ${UI_IDLE_RESET_MS}ms ease`;
			step1Label.style.opacity = "1";
			step2Label.style.transition = `opacity ${UI_IDLE_RESET_MS}ms ease`;
			step2Label.style.opacity = "0";
			bottomIdle.style.transition = `opacity ${UI_IDLE_RESET_MS}ms ease`;
			bottomIdle.style.opacity = "1";
			bottomIdle.style.pointerEvents = "auto";
			restartBtn.style.transition = `opacity ${UI_IDLE_RESET_MS}ms ease`;
			restartBtn.style.opacity = "0";
			restartBtn.style.pointerEvents = "none";
			updateIdleLabels();
		}

		function isCircleDrawingMode() {
			return !uiActive && !loading && !revealed && !cheatProceduralDone;
		}

		function syncCursor() {
			canvas!.classList.toggle("cursor-crosshair", isCircleDrawingMode());
		}

		function syncControls() {
			const clearDisabled = circles.length === 0 || (uiActive && !cheatProceduralDone);
			clearBtns.forEach((button) => {
				button.disabled = clearDisabled;
			});
			const awaitingCheatAi = isCheatMode() && cheatProceduralDone;
			compareBtn.disabled =
				budgetDepleted ||
				circles.length === 0 ||
				loading ||
				revealed ||
				(uiActive && !awaitingCheatAi);
			syncCursor();
		}

		function clearAll() {
			circles.length = 0;
			resetOverlays();
			resetUi();
			setError(budgetDepleted ? "Owl budget depleted." : "", { fundsCta: budgetDepleted });
			render();
			syncControls();
		}

		function restart() {
			clearAll();
		}

		function setError(message: string, options?: { fundsCta?: boolean }) {
			errorMessageEl.textContent = message;
			errorEl.classList.toggle("hidden", !message);
			errorEl.classList.toggle("flex", Boolean(message));
			errorIcon.classList.toggle("hidden", !options?.fundsCta);
			errorCta.classList.toggle("hidden", !options?.fundsCta);
		}

		function revealOwlStats() {
			if (statsRevealed) return;
			statsRevealed = true;
			root.setAttribute("data-stats-open", "");
			statBoxes.forEach((box, index) => {
				setTimeout(() => {
					box.style.opacity = "1";
				}, STATS_EXPAND_MS + index * STATS_STAGGER_MS);
			});
		}

		function applyBudget(value: unknown) {
			const next = Number(value);
			if (Number.isFinite(next) && next >= 0) budgetUsd = next;
		}

		function updateOwlStats(
			owls: unknown,
			options?: { warnIfDepleted?: boolean; budget?: unknown },
		) {
			if (options && "budget" in options) applyBudget(options.budget);

			const count = Number(owls);
			if (!Number.isFinite(count)) return;

			const [countEl, consumedEl, remainingEl] = statValues;
			if (!countEl || !consumedEl || !remainingEl) return;

			const consumed = owlBudgetConsumed(count);
			const remaining = owlBudgetRemaining(count, budgetUsd);
			budgetDepleted = !canGenerateOwl(count, budgetUsd);

			countEl.textContent = String(count);
			consumedEl.textContent = `$${consumed.toFixed(2)}`;
			remainingEl.textContent = `$${remaining.toFixed(2)}`;

			if (budgetDepleted) {
				if (options?.warnIfDepleted) {
					setError("Owl budget depleted.", { fundsCta: true });
				}
			} else if (options?.warnIfDepleted) {
				setError("");
			}
			syncControls();
		}

		async function loadOwlCount() {
			try {
				const response = await fetch("/api/drawOwl");
				if (!response.ok) return;
				const data = await response.json();
				updateOwlStats(data.owls, { warnIfDepleted: true, budget: data.budget });
			} catch {
				// Stats stay at placeholders if the API isn't available yet
			}
		}

		async function requestAiImage(): Promise<string> {
			const circle1 = circles[0];
			if (!circle1) throw new Error("Draw at least one circle first.");

			const response = await fetch("/api/drawOwl", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					circle1: { cx: circle1.cx, cy: circle1.cy, rx: circle1.rx, ry: circle1.ry },
					...(circles[1]
						? {
								circle2: {
									cx: circles[1].cx,
									cy: circles[1].cy,
									rx: circles[1].rx,
									ry: circles[1].ry,
								},
							}
						: {}),
				}),
			});

			const data = await response.json().catch(() => ({}));
			if (data.owls != null) updateOwlStats(data.owls, { budget: data.budget });
			if (!response.ok) {
				if (data.error === "budget" || response.status === 402) {
					throw Object.assign(new Error("Owl budget depleted."), { fundsCta: true });
				}
				throw new Error(data.message ?? `HTTP ${response.status}`);
			}
			if (typeof data.image !== "string") {
				throw new Error("No image returned.");
			}
			return normalizeAiImageWhitePoint(data.image);
		}

		function toCanvasPoint(e: PointerEvent) {
			const rect = canvas!.getBoundingClientRect();
			return {
				x: ((e.clientX - rect.left) / rect.width) * canvas!.width,
				y: ((e.clientY - rect.top) / rect.height) * canvas!.height,
			};
		}

		function buildCircle(a: { x: number; y: number }, b: { x: number; y: number }): Circle {
			return {
				cx: (a.x + b.x) / 2,
				cy: (a.y + b.y) / 2,
				rx: Math.abs(b.x - a.x) / 2,
				ry: Math.abs(b.y - a.y) / 2,
			};
		}

		canvas.addEventListener("pointerdown", (e) => {
			if (!isCircleDrawingMode() || circles.length >= MAX_CIRCLES) return;
			canvas.setPointerCapture(e.pointerId);
			start = toCanvasPoint(e);
		});

		canvas.addEventListener("pointermove", (e) => {
			if (!start) return;
			preview = buildCircle(start, toCanvasPoint(e));
			render();
		});

		function finishStroke() {
			if (preview && preview.rx > 12 && preview.ry > 12) {
				circles.push(preview);
			}
			start = null;
			preview = null;
			render();
			syncControls();
		}

		canvas.addEventListener("pointerup", finishStroke);
		canvas.addEventListener("pointercancel", finishStroke);

		clearBtns.forEach((button) => button.addEventListener("click", clearAll));
		restartBtn.addEventListener("click", restart);

		cheatCheckbox.addEventListener("change", () => {
			if (loading) return;
			if (uiActive || revealed || cheatProceduralDone) restart();
			else updateIdleLabels();
		});

		if (externalCheatCheckbox) {
			cheatCheckbox.checked = externalCheatCheckbox.checked;
			externalCheatCheckbox.addEventListener("change", () => {
				cheatCheckbox.checked = externalCheatCheckbox.checked;
				cheatCheckbox.dispatchEvent(new Event("change"));
			});
		}

		async function runAiGeneration(activeId: number) {
			loading = true;
			setError("");
			if (isCheatMode() && cheatProceduralDone) {
				uiActive = true;
				fadeOutElement(bottomIdle, UI_IDLE_FADE_OUT_MS);
				bottomIdle.style.pointerEvents = "none";
			}
			syncControls();

			try {
				const image = await requestAiImage();
				if (activeId !== generationId) return;
				fadeOverlay(aiOverlay, image, 1000, { blurFromPx: SKETCH_BLUR_PX });
				revealOwlStats();
				if (isCheatMode() && cheatProceduralDone) {
					step2Label.textContent = STEP3_CHEAT_LABEL;
				}
				revealCompleteUi(activeId, { skipStep2: isCheatMode() && cheatProceduralDone });
				revealed = true;
			} catch (err) {
				if (activeId !== generationId) return;
				if (isCheatMode() && cheatProceduralDone) {
					uiActive = false;
					bottomIdle.style.opacity = "1";
					bottomIdle.style.pointerEvents = "auto";
				} else {
					resetUi();
				}
				setError(err instanceof Error ? err.message : "Request failed", {
					fundsCta: Boolean(err && typeof err === "object" && "fundsCta" in err),
				});
			} finally {
				if (activeId === generationId) {
					loading = false;
					syncControls();
				}
			}
		}

		compareBtn.addEventListener("click", async () => {
			if (circles.length === 0 || loading || revealed) return;
			if (uiActive && !(isCheatMode() && cheatProceduralDone)) return;
			if (budgetDepleted) {
				setError("Owl budget depleted.", { fundsCta: true });
				return;
			}

			if (isCheatMode() && cheatProceduralDone) {
				const id = ++generationId;
				await runAiGeneration(id);
				return;
			}

			if (isCheatMode()) {
				const id = ++generationId;
				setError("");
				beginCheatDrawing();

				setPencilBlendMode(false);
				fadeOverlay(pencilOverlay, buildCheatOverlayImage(), CHEAT_PENCIL_FADE_MS, {
					blurFromPx: SKETCH_BLUR_PX,
				});

				uiTimeouts.push(
					setTimeout(() => {
						if (id !== generationId) return;
						showCheatStep2Ui();
					}, CHEAT_PENCIL_FADE_MS),
				);
				return;
			}

			const id = ++generationId;
			setError("");
			beginDrawing();
			syncControls();

			setPencilBlendMode(true);
			fadeOverlay(pencilOverlay, buildCheatOverlayImage(), 5000);

			await runAiGeneration(id);
		});

		void loadOwlCount();
		updateIdleLabels();
		render();
		syncControls();
	});
</script>
