						>
							2. Draw the rest of the owl
						</button>
						<button
							data-owl-clear
							type="button"
							class="font-comic hidden shrink-0 cursor-pointer appearance-none border border-transparent bg-transparent px-1.5 py-0.5 text-[16px] text-black shadow-none outline-none hover:border-black disabled:cursor-not-allowed disabled:opacity-40 sm:block sm:px-2 sm:text-[18px]"
						>
							Clear
						</button>
					</div>
					<button
						data-owl-restart
						type="button"
						class="font-comic pointer-events-none absolute bottom-0 right-0 cursor-pointer appearance-none border-0 bg-transparent p-0 text-[16px] text-black opacity-0 shadow-none outline-none sm:text-[18px]"
