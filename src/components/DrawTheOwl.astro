---
import { OWL_PROMPT } from "../../api/owlModels";

const MAX_CIRCLES = 2;
---

<div class="not-prose my-8 mx-auto flex w-full max-w-xl flex-col items-center" data-owl>
	<label class="hidden">
		<input data-owl-cheat type="checkbox" />
		<span>Cheat mode (debug)</span>
	</label>

	<figure class="m-0 w-full">
		<div
			class="relative isolate overflow-hidden rounded-lg border border-zinc-300 bg-white shadow-sm dark:border-zinc-600"
		>
			<canvas
				data-owl-canvas
				width="1024"
				height="1024"
				class="aspect-square w-full cursor-crosshair touch-none bg-white"
			></canvas>
			<img
				data-owl-pencil-overlay
				alt=""
				class="pointer-events-none absolute inset-0 h-full w-full object-contain opacity-0 mix-blend-multiply blur-md"
			/>
			<img
				data-owl-ai-overlay
				alt=""
				class="pointer-events-none absolute inset-0 h-full w-full object-contain opacity-0"
			/>
			<p
				data-owl-step1
				class="pointer-events-none absolute left-4 top-4 z-10 m-0 text-[16px] font-['Comic_Sans_MS','Comic_Sans',cursive] text-black sm:left-6 sm:top-5 sm:text-[20px]"
			>
				1. Draw some circles
			</p>
			<p
				data-owl-step2
				class="pointer-events-none absolute left-4 top-4 z-10 m-0 text-[16px] font-['Comic_Sans_MS','Comic_Sans',cursive] text-black opacity-0 sm:left-6 sm:top-5 sm:text-[20px]"
			>
				2. Draw the rest of the owl
			</p>
			<div class="absolute inset-x-3 bottom-2 z-10 sm:inset-x-4 sm:bottom-3">
				<div
					data-owl-bottom-idle
					class="flex items-center gap-2 sm:gap-4"
				>
					<button
						data-owl-compare
						type="button"
						class="min-w-0 flex-1 cursor-pointer appearance-none border-0 bg-transparent p-0 text-center text-[16px] font-['Comic_Sans_MS','Comic_Sans',cursive] text-black shadow-none outline-none disabled:cursor-not-allowed disabled:opacity-40 sm:text-[18px]"
					>
						2. Draw the rest of the owl
					</button>
					<button
						data-owl-clear
						type="button"
						class="shrink-0 cursor-pointer appearance-none border border-transparent bg-transparent px-1.5 py-0.5 text-[16px] font-['Comic_Sans_MS','Comic_Sans',cursive] text-black shadow-none outline-none hover:border-black disabled:cursor-not-allowed disabled:opacity-40 sm:px-2 sm:text-[18px]"
					>
						Clear
					</button>
				</div>
				<button
					data-owl-restart
					type="button"
					class="pointer-events-none absolute bottom-0 right-0 opacity-0 cursor-pointer appearance-none border-0 bg-transparent p-0 text-[16px] font-['Comic_Sans_MS','Comic_Sans',cursive] text-black shadow-none outline-none sm:text-[18px]"
				>
					Restart
				</button>
			</div>
		</div>
	</figure>

	<label class="hidden">
		<span>Prompt</span>
		<textarea data-owl-prompt rows="6">{OWL_PROMPT}</textarea>
	</label>

	<p data-owl-error class="hidden w-full text-center text-sm text-red-500"></p>
</div>

<script>
	import { pencilfyOwl, type OwlCircle } from "@/utils/pencilfyOwl";

	type Circle = OwlCircle;

	type ModelMeta = { id: string; settings: string };

	const LOCAL_MODELS: ModelMeta[] = [
		{ id: "x-ai/grok-imagine-image-quality", settings: "1:1, 1K" },
	];

	const MAX_CIRCLES = 2;
	const PENCIL = "#374151";
	const SKETCH_BLUR_PX = 12;
	const UI_IDLE_FADE_OUT_MS = 5000;
	const UI_IDLE_RESET_MS = 300;
	const CIRCLE_BLUR_PX = 6;
	const UI_REVEAL_FADE_MS = 1000;
	const STEP2_DELAY_AFTER_AI_MS = 500;
	const RESTART_DELAY_AFTER_STEP2_MS = 1500;

	const STEP2_LABEL = "2. Draw the rest of the owl";
	const STEP2_CHEAT_LABEL = "2. Cheat with a procedurally generated owl...";
	const STEP3_CHEAT_LABEL = "3. Draw the rest of the owl";
	const CHEAT_PENCIL_FADE_MS = 1000;

	const DEFAULT_CIRCLES: Circle[] = [
		{ cx: 512, cy: 568, rx: 217, ry: 308 },
		{ cx: 420, cy: 255, rx: 110, ry: 115 },
	];

	function hideOverlay(el: HTMLImageElement) {
		el.style.transition = "none";
		el.style.opacity = "0";
		el.style.filter = "";
		el.removeAttribute("src");
		void el.offsetWidth;
		el.style.transition = "";
	}

	function fadeInElement(el: HTMLElement, durationMs: number) {
		el.style.transition = "none";
		el.style.opacity = "0";
		void el.offsetWidth;
		el.style.transition = `opacity ${durationMs}ms ease`;
		el.style.opacity = "1";
	}

	function fadeOutElement(el: HTMLElement, durationMs: number) {
		el.style.transition = `opacity ${durationMs}ms ease`;
		el.style.opacity = "0";
	}

	function fadeOverlay(
		el: HTMLImageElement,
		src: string,
		durationMs: number,
		options?: { blurFromPx?: number },
	) {
		const blurFromPx = options?.blurFromPx;
		el.style.transition = "none";
		el.style.opacity = "0";
		if (blurFromPx != null) {
			el.style.filter = `blur(${blurFromPx}px)`;
		}
		el.src = src;
		void el.offsetWidth;
		el.style.transition =
			blurFromPx != null
				? `opacity ${durationMs}ms ease, filter ${durationMs}ms ease`
				: `opacity ${durationMs}ms ease`;
		el.style.opacity = "1";
		if (blurFromPx != null) {
			el.style.filter = "blur(0px)";
		}
	}

	function pixelLuminance(r: number, g: number, b: number) {
		return 0.299 * r + 0.587 * g + 0.114 * b;
	}

	async function normalizeAiImageWhitePoint(dataUrl: string): Promise<string> {
		const img = new Image();
		await new Promise<void>((resolve, reject) => {
			img.onload = () => resolve();
			img.onerror = () => reject(new Error("Failed to load AI image."));
			img.src = dataUrl;
		});

		const work = document.createElement("canvas");
		work.width = img.naturalWidth;
		work.height = img.naturalHeight;
		const workCtx = work.getContext("2d");
		if (!workCtx) return dataUrl;

		workCtx.drawImage(img, 0, 0);
		const imageData = workCtx.getImageData(0, 0, work.width, work.height);
		const { data } = imageData;

		let brightestIdx = 0;
		let maxLuminance = -1;
		for (let i = 0; i < data.length; i += 4) {
			const lum = pixelLuminance(data[i]!, data[i + 1]!, data[i + 2]!);
			if (lum > maxLuminance) {
				maxLuminance = lum;
				brightestIdx = i;
			}
		}

		const scaleR = 255 / Math.max(data[brightestIdx]!, 1);
		const scaleG = 255 / Math.max(data[brightestIdx + 1]!, 1);
		const scaleB = 255 / Math.max(data[brightestIdx + 2]!, 1);

		for (let i = 0; i < data.length; i += 4) {
			data[i] = Math.min(255, Math.round(data[i]! * scaleR));
			data[i + 1] = Math.min(255, Math.round(data[i + 1]! * scaleG));
			data[i + 2] = Math.min(255, Math.round(data[i + 2]! * scaleB));
		}

		workCtx.putImageData(imageData, 0, 0);
		return work.toDataURL("image/png");
	}

	document.querySelectorAll<HTMLElement>("[data-owl]").forEach((root) => {
		const canvas = root.querySelector<HTMLCanvasElement>("[data-owl-canvas]");
		const ctx = canvas?.getContext("2d");
		if (!canvas || !ctx) return;

		const pencilOverlay = root.querySelector<HTMLImageElement>("[data-owl-pencil-overlay]")!;
		const aiOverlay = root.querySelector<HTMLImageElement>("[data-owl-ai-overlay]")!;
		const step1Label = root.querySelector<HTMLElement>("[data-owl-step1]")!;
		const step2Label = root.querySelector<HTMLElement>("[data-owl-step2]")!;
		const bottomIdle = root.querySelector<HTMLElement>("[data-owl-bottom-idle]")!;
		const clearBtn = root.querySelector<HTMLButtonElement>("[data-owl-clear]")!;
		const restartBtn = root.querySelector<HTMLButtonElement>("[data-owl-restart]")!;
		const compareBtn = root.querySelector<HTMLButtonElement>("[data-owl-compare]")!;
		const cheatCheckbox = root.querySelector<HTMLInputElement>("[data-owl-cheat]")!;
		const promptInput = root.querySelector<HTMLTextAreaElement>("[data-owl-prompt]")!;
		const errorEl = root.querySelector<HTMLElement>("[data-owl-error]")!;

		const circles: Circle[] = DEFAULT_CIRCLES.map((c) => ({ ...c }));
		let start: { x: number; y: number } | null = null;
		let preview: Circle | null = null;
		let loading = false;
		let revealed = false;
		let uiActive = false;
		let cheatProceduralDone = false;
		let cachedGuideImage: string | null = null;
		let generationId = 0;
		let uiTimeouts: ReturnType<typeof setTimeout>[] = [];
		let models: ModelMeta[] = LOCAL_MODELS;

		const pencilCanvas = document.createElement("canvas");
		pencilCanvas.width = canvas.width;
		pencilCanvas.height = canvas.height;

		function strokeEllipse(c: Circle) {
			ctx!.save();
			ctx!.strokeStyle = PENCIL;
			ctx!.lineWidth = 10;
			ctx!.lineCap = "round";
			for (let pass = 0; pass < 2; pass++) {
				const jitter = pass === 0 ? 0 : 3;
				ctx!.beginPath();
				ctx!.ellipse(c.cx + jitter, c.cy - jitter, c.rx, c.ry, 0, 0, Math.PI * 2);
				ctx!.stroke();
			}
			ctx!.restore();
		}

		function render() {
			ctx!.fillStyle = "#ffffff";
			ctx!.fillRect(0, 0, canvas!.width, canvas!.height);
			for (const c of circles) strokeEllipse(c);
			if (preview) strokeEllipse(preview);
		}

		function clearUiTimeouts() {
			for (const timeout of uiTimeouts) clearTimeout(timeout);
			uiTimeouts = [];
		}

		function isCheatMode() {
			return cheatCheckbox.checked;
		}

		function setPencilBlendMode(useMultiply: boolean) {
			pencilOverlay.classList.toggle("mix-blend-multiply", useMultiply);
		}

		function updateIdleLabels() {
			if (isCheatMode()) {
				step2Label.textContent = STEP2_CHEAT_LABEL;
				compareBtn.textContent = cheatProceduralDone ? STEP3_CHEAT_LABEL : STEP2_CHEAT_LABEL;
			} else {
				step2Label.textContent = STEP2_LABEL;
				compareBtn.textContent = STEP2_LABEL;
			}
		}

		function buildGuideImages() {
			pencilfyOwl(pencilCanvas, circles, { background: null });
			const overlayImage = pencilCanvas.toDataURL("image/png");

			const guideCanvas = document.createElement("canvas");
			guideCanvas.width = pencilCanvas.width;
			guideCanvas.height = pencilCanvas.height;
			const guideCtx = guideCanvas.getContext("2d")!;
			guideCtx.fillStyle = "#ffffff";
			guideCtx.fillRect(0, 0, guideCanvas.width, guideCanvas.height);
			guideCtx.drawImage(pencilCanvas, 0, 0);

			return {
				overlayImage,
				guideImage: guideCanvas.toDataURL("image/png"),
			};
		}

		function resetOverlays() {
			generationId += 1;
			revealed = false;
			cheatProceduralDone = false;
			cachedGuideImage = null;
			clearUiTimeouts();
			setPencilBlendMode(true);
			hideOverlay(pencilOverlay);
			hideOverlay(aiOverlay);
		}

		function blurCircleLayer(durationMs: number) {
			canvas!.style.transition = "none";
			canvas!.style.filter = "blur(0px)";
			void canvas!.offsetWidth;
			canvas!.style.transition = `filter ${durationMs}ms ease`;
			canvas!.style.filter = `blur(${CIRCLE_BLUR_PX}px)`;
		}

		function resetCircleBlur() {
			canvas!.style.transition = "none";
			canvas!.style.filter = "";
			void canvas!.offsetWidth;
			canvas!.style.transition = "";
		}

		function beginDrawing() {
			uiActive = true;
			clearUiTimeouts();
			step2Label.style.opacity = "0";
			restartBtn.style.opacity = "0";
			restartBtn.style.pointerEvents = "none";
			fadeOutElement(step1Label, UI_IDLE_FADE_OUT_MS);
			fadeOutElement(bottomIdle, UI_IDLE_FADE_OUT_MS);
			bottomIdle.style.pointerEvents = "none";
			blurCircleLayer(UI_IDLE_FADE_OUT_MS);
		}

		function beginCheatDrawing() {
			uiActive = true;
			clearUiTimeouts();
			step1Label.style.transition = "none";
			step1Label.style.opacity = "0";
			step2Label.textContent = STEP2_CHEAT_LABEL;
			step2Label.style.transition = "none";
			step2Label.style.opacity = "1";
			void step1Label.offsetWidth;
			step1Label.style.transition = "";
			step2Label.style.transition = "";
			restartBtn.style.opacity = "0";
			restartBtn.style.pointerEvents = "none";
			fadeOutElement(bottomIdle, UI_IDLE_FADE_OUT_MS);
			bottomIdle.style.pointerEvents = "none";
		}

		function revealCompleteUi(activeId: number, options?: { skipStep2?: boolean }) {
			if (!options?.skipStep2) {
				uiTimeouts.push(
					setTimeout(() => {
						if (activeId !== generationId) return;
						fadeInElement(step2Label, UI_REVEAL_FADE_MS);
					}, STEP2_DELAY_AFTER_AI_MS),
				);
			}

			uiTimeouts.push(
				setTimeout(() => {
					if (activeId !== generationId) return;
					fadeInElement(restartBtn, UI_REVEAL_FADE_MS);
					restartBtn.style.pointerEvents = "auto";
				}, options?.skipStep2
					? RESTART_DELAY_AFTER_STEP2_MS
					: STEP2_DELAY_AFTER_AI_MS + RESTART_DELAY_AFTER_STEP2_MS),
			);
		}

		function showCheatStep2Ui() {
			cheatProceduralDone = true;
			uiActive = false;
			compareBtn.textContent = STEP3_CHEAT_LABEL;
			fadeInElement(bottomIdle, UI_REVEAL_FADE_MS);
			bottomIdle.style.pointerEvents = "auto";
			syncControls();
		}

		function resetUi() {
			uiActive = false;
			clearUiTimeouts();
			resetCircleBlur();
			step1Label.style.transition = `opacity ${UI_IDLE_RESET_MS}ms ease`;
			step1Label.style.opacity = "1";
			step2Label.style.transition = `opacity ${UI_IDLE_RESET_MS}ms ease`;
			step2Label.style.opacity = "0";
			bottomIdle.style.transition = `opacity ${UI_IDLE_RESET_MS}ms ease`;
			bottomIdle.style.opacity = "1";
			bottomIdle.style.pointerEvents = "auto";
			restartBtn.style.transition = `opacity ${UI_IDLE_RESET_MS}ms ease`;
			restartBtn.style.opacity = "0";
			restartBtn.style.pointerEvents = "none";
			updateIdleLabels();
		}

		function isCircleDrawingMode() {
			return !uiActive && !loading && !revealed && !cheatProceduralDone;
		}

		function syncCursor() {
			canvas!.classList.toggle("cursor-crosshair", isCircleDrawingMode());
		}

		function syncControls() {
			clearBtn.disabled = circles.length === 0 || (uiActive && !cheatProceduralDone);
			const awaitingCheatAi = isCheatMode() && cheatProceduralDone;
			compareBtn.disabled =
				circles.length === 0 ||
				loading ||
				revealed ||
				(uiActive && !awaitingCheatAi);
			promptInput.disabled = loading;
			syncCursor();
		}

		function clearAll() {
			circles.length = 0;
			resetOverlays();
			resetUi();
			setError("");
			render();
			syncControls();
		}

		function restart() {
			clearAll();
		}

		function setError(message: string) {
			errorEl.textContent = message;
			errorEl.classList.toggle("hidden", !message);
		}

		async function loadModels() {
			try {
				const response = await fetch("/api/drawOwl");
				if (!response.ok) return;
				const data = await response.json();
				if (Array.isArray(data.models) && data.models.length > 0) {
					models = data.models;
				}
			} catch {
				// Keep the bundled model list if the API isn't available yet
			}
		}

		async function requestAiImage(guideImage: string, model: ModelMeta): Promise<string> {
			const response = await fetch("/api/drawOwl", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					image: guideImage,
					model: model.id,
					prompt: promptInput.value.trim(),
				}),
			});

			const data = await response.json().catch(() => ({}));
			if (!response.ok) {
				throw new Error(data.message ?? `HTTP ${response.status}`);
			}
			if (typeof data.image !== "string") {
				throw new Error("No image returned.");
			}
			return normalizeAiImageWhitePoint(data.image);
		}

		function toCanvasPoint(e: PointerEvent) {
			const rect = canvas!.getBoundingClientRect();
			return {
				x: ((e.clientX - rect.left) / rect.width) * canvas!.width,
				y: ((e.clientY - rect.top) / rect.height) * canvas!.height,
			};
		}

		function buildCircle(a: { x: number; y: number }, b: { x: number; y: number }): Circle {
			return {
				cx: (a.x + b.x) / 2,
				cy: (a.y + b.y) / 2,
				rx: Math.abs(b.x - a.x) / 2,
				ry: Math.abs(b.y - a.y) / 2,
			};
		}

		canvas.addEventListener("pointerdown", (e) => {
			if (!isCircleDrawingMode() || circles.length >= MAX_CIRCLES) return;
			canvas.setPointerCapture(e.pointerId);
			start = toCanvasPoint(e);
		});

		canvas.addEventListener("pointermove", (e) => {
			if (!start) return;
			preview = buildCircle(start, toCanvasPoint(e));
			render();
		});

		function finishStroke() {
			if (preview && preview.rx > 12 && preview.ry > 12) {
				circles.push(preview);
			}
			start = null;
			preview = null;
			render();
			syncControls();
		}

		canvas.addEventListener("pointerup", finishStroke);
		canvas.addEventListener("pointercancel", finishStroke);

		clearBtn.addEventListener("click", clearAll);
		restartBtn.addEventListener("click", restart);

		cheatCheckbox.addEventListener("change", () => {
			if (!uiActive && !loading && !revealed && !cheatProceduralDone) {
				updateIdleLabels();
			}
		});

		async function runAiGeneration(activeId: number, guideImage: string, model: ModelMeta) {
			loading = true;
			setError("");
			if (isCheatMode() && cheatProceduralDone) {
				uiActive = true;
				fadeOutElement(bottomIdle, UI_IDLE_FADE_OUT_MS);
				bottomIdle.style.pointerEvents = "none";
			}
			syncControls();

			try {
				const image = await requestAiImage(guideImage, model);
				if (activeId !== generationId) return;
				fadeOverlay(aiOverlay, image, 1000, { blurFromPx: SKETCH_BLUR_PX });
				if (isCheatMode() && cheatProceduralDone) {
					step2Label.textContent = STEP3_CHEAT_LABEL;
				}
				revealCompleteUi(activeId, { skipStep2: isCheatMode() && cheatProceduralDone });
				revealed = true;
			} catch (err) {
				if (activeId !== generationId) return;
				if (isCheatMode() && cheatProceduralDone) {
					uiActive = false;
					bottomIdle.style.opacity = "1";
					bottomIdle.style.pointerEvents = "auto";
				} else {
					resetUi();
				}
				setError(err instanceof Error ? err.message : "Request failed");
			} finally {
				if (activeId === generationId) {
					loading = false;
					syncControls();
				}
			}
		}

		compareBtn.addEventListener("click", async () => {
			if (circles.length === 0 || loading || revealed) return;
			if (uiActive && !(isCheatMode() && cheatProceduralDone)) return;

			if (models.length === 0) {
				await loadModels();
			}
			const model = models[0];
			if (!model) {
				setError("Could not load model list.");
				return;
			}

			if (isCheatMode() && cheatProceduralDone) {
				if (!cachedGuideImage) return;
				const id = ++generationId;
				await runAiGeneration(id, cachedGuideImage, model);
				return;
			}

			if (isCheatMode()) {
				const id = ++generationId;
				setError("");
				beginCheatDrawing();

				const { overlayImage, guideImage } = buildGuideImages();
				cachedGuideImage = guideImage;
				setPencilBlendMode(false);
				fadeOverlay(pencilOverlay, overlayImage, CHEAT_PENCIL_FADE_MS, {
					blurFromPx: SKETCH_BLUR_PX,
				});

				uiTimeouts.push(
					setTimeout(() => {
						if (id !== generationId) return;
						showCheatStep2Ui();
					}, CHEAT_PENCIL_FADE_MS),
				);
				return;
			}

			const id = ++generationId;
			setError("");
			beginDrawing();
			syncControls();

			const { overlayImage, guideImage } = buildGuideImages();
			setPencilBlendMode(true);
			fadeOverlay(pencilOverlay, overlayImage, 5000);

			await runAiGeneration(id, guideImage, model);
		});

		void loadModels();
		updateIdleLabels();
		render();
		syncControls();
	});
</script>
